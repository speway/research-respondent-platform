# Research Respondent Platform - environment template.
#
# Copy to `.env` for local use:  copy .env.example .env   (Windows)
#                               cp .env.example .env      (macOS / Linux)
#
# Scope note: Next.js loads `.env` automatically for `next dev`, `next build`
# and `next start`. The standalone CLI scripts (`npm run db:migrate`,
# `npm run db:status`, `npm run bootstrap`) read the process environment
# directly and do NOT parse `.env` files, because this project has no dotenv
# dependency. Set the variable in your shell for those commands, for example:
#   PowerShell:  $env:DATABASE_FILE = "C:\data\respondent-platform.db"
#   bash:        DATABASE_FILE=/data/respondent-platform.db npm run db:migrate
#
# No secret value belongs in this file or in version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Path to the SQLite database file used by the application, the migration CLI
# and the bootstrap CLI. Read by db/index.ts (resolveDatabaseFile) and by
# scripts/migrate.ts and scripts/bootstrap.ts.
# Default when unset: <project root>/data/respondent-platform.db
# The parent directory is created on demand. A relative path resolves against
# the current working directory, so an absolute path is safer for servers.
DATABASE_FILE=./data/respondent-platform.db

# Legacy alias. db/index.ts falls back to DATABASE_PATH when DATABASE_FILE is
# unset or blank. Leave empty unless an existing deployment still exports it.
DATABASE_PATH=

# ---------------------------------------------------------------------------
# Runtime (set by the platform, listed here for completeness)
# ---------------------------------------------------------------------------

# Standard Node.js environment name. Read by app/actions/auth.ts to decide the
# `Secure` flag of the session cookie (secure only when the value is exactly
# "production"). Next.js sets this for you; only set it explicitly when running
# the server outside Next.js.
# NODE_ENV=development

# ---------------------------------------------------------------------------
# Operating-system variables read by the code (do not set them here)
# ---------------------------------------------------------------------------

# db/index.ts labels every row of schema_migration with the operating-system
# account name: process.env.USERNAME (Windows) or process.env.USER (POSIX),
# defaulting to "system". These come from the OS, not from `.env`.
# USERNAME=
# USER=

# ---------------------------------------------------------------------------
# Reserved secret references (names only, never values)
# ---------------------------------------------------------------------------

# lib/domain/adapters/google-forms.ts exports GOOGLE_FORMS_SECRET_REF with this
# exact name. Today it is only a *reference* that is recorded in evidence
# bodies: no code reads the variable and no Google Forms transport is
# implemented. If an authorized, evidenced submission path is ever approved,
# the transport must read the service-account JSON from this variable (or a
# secret manager) and the value must never be logged, stored in a contract or
# written to the database.
# GOOGLE_FORMS_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# GitHub Actions / CI convenience (optional, not read by application code)
# ---------------------------------------------------------------------------

# Disables the Next.js anonymous telemetry ping during builds.
# NEXT_TELEMETRY_DISABLED=1

# Private file cabinet (separate from legacy SQLite and Preview diagnostics).
# RRP_CABINET_STORE_ID=
# RRP_CABINET_ACCOUNTS=
# Accounts JSON contains id, login, label, password {hash,salt,params}; never plaintext.
# RRP_CABINET_PROOF=1 # protected Preview only, never production
