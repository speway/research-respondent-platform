{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "invite"
            },
            "login": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{3,40}$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "starterCredits": {
              "default": 5,
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": [
            "command",
            "login",
            "label",
            "group"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "disable"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "command",
            "participantId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "review_study"
            },
            "studyId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "accepted": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "command",
            "studyId",
            "accepted",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "close_study"
            },
            "studyId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "command",
            "studyId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "review_response"
            },
            "responseId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "accepted": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "command",
            "responseId",
            "accepted",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "experiment"
            },
            "requestId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "experiment": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "hypothesis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "holdoutReference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "modelId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "promptVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "settings": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "retestDays": {
                  "default": 14,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "participantIds": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "questions": {
                  "minItems": 1,
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "kind": {
                            "type": "string",
                            "const": "scale"
                          },
                          "low": {
                            "type": "integer",
                            "minimum": -100,
                            "maximum": 100
                          },
                          "high": {
                            "type": "integer",
                            "minimum": -100,
                            "maximum": 100
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "low",
                          "high"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "kind": {
                            "type": "string",
                            "const": "choice"
                          },
                          "options": {
                            "minItems": 2,
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "code": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1000
                                }
                              },
                              "required": [
                                "code",
                                "label"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind",
                          "options"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1000
                          },
                          "kind": {
                            "type": "string",
                            "const": "text"
                          },
                          "maxLength": {
                            "default": 1000,
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2000
                          },
                          "required": {
                            "default": true,
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "holdoutConfirmed": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "title",
                "hypothesis",
                "holdoutReference",
                "modelId",
                "promptVersion",
                "settings",
                "participantIds",
                "questions",
                "holdoutConfirmed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "command",
            "requestId",
            "experiment"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "agent_key"
            },
            "experimentId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "arm": {
              "type": "string",
              "enum": [
                "personal",
                "baseline"
              ]
            }
          },
          "required": [
            "command",
            "experimentId",
            "participantId",
            "arm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "const": "revoke_key"
            },
            "keyId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "command",
            "keyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "run_prediction"
        },
        "experimentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "participantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "arm": {
          "type": "string",
          "enum": [
            "personal",
            "baseline"
          ]
        },
        "confirmModelProcessing": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "command",
        "experimentId",
        "participantId",
        "arm",
        "confirmModelProcessing"
      ],
      "additionalProperties": false
    }
  ]
}
