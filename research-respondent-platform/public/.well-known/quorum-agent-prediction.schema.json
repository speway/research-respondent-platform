{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "settings": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "answers",
    "modelId",
    "promptVersion",
    "settings"
  ],
  "additionalProperties": false
}
