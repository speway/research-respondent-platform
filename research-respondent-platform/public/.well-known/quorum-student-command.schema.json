{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "study"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "study": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "purpose": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "reviewRules": {
              "type": "string",
              "minLength": 20,
              "maxLength": 1000
            },
            "consentText": {
              "type": "string",
              "minLength": 20,
              "maxLength": 2000
            },
            "durationMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "eligibleGroups": {
              "default": [],
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "reward": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "questions": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "kind": {
                        "type": "string",
                        "const": "scale"
                      },
                      "low": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100
                      },
                      "high": {
                        "type": "integer",
                        "minimum": -100,
                        "maximum": 100
                      },
                      "required": {
                        "default": true,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "kind",
                      "low",
                      "high"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "kind": {
                        "type": "string",
                        "const": "choice"
                      },
                      "options": {
                        "minItems": 2,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1000
                            }
                          },
                          "required": [
                            "code",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": {
                        "default": true,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "kind",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "kind": {
                        "type": "string",
                        "const": "text"
                      },
                      "maxLength": {
                        "default": 1000,
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2000
                      },
                      "required": {
                        "default": true,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "title",
            "purpose",
            "reference",
            "reviewRules",
            "consentText",
            "durationMinutes",
            "target",
            "reward",
            "questions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command",
        "requestId",
        "study"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "submit"
        },
        "studyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "consent": {
          "type": "boolean",
          "const": true
        },
        "humanAttestation": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "command",
        "studyId",
        "answers",
        "consent",
        "humanAttestation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "close_study"
        },
        "studyId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "command",
        "studyId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "withdraw_response"
        },
        "responseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "command",
        "responseId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "appeal"
        },
        "responseId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "command",
        "responseId",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "profile"
        },
        "profile": {
          "type": "object",
          "properties": {
            "narrative": {
              "type": "string",
              "minLength": 50,
              "maxLength": 6000
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "consentModeling": {
              "type": "boolean",
              "const": true
            },
            "excludesHoldoutAnswers": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "narrative",
            "reference",
            "consentModeling",
            "excludesHoldoutAnswers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "command",
        "profile"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "withdraw_profile"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "consent_experiment"
        },
        "experimentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "consent": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "command",
        "experimentId",
        "consent"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "human"
        },
        "experimentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "first",
            "retest"
          ]
        },
        "answers": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "consent": {
          "type": "boolean",
          "const": true
        },
        "humanAttestation": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "command",
        "experimentId",
        "phase",
        "answers",
        "consent",
        "humanAttestation"
      ],
      "additionalProperties": false
    }
  ]
}
