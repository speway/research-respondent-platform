{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "rrp.observed-form.v1"
    },
    "url": {
      "type": "string"
    },
    "requestedUrl": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "scope": {
      "type": "string",
      "enum": [
        "visible_section",
        "complete_form"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "method": {
      "type": "string",
      "const": "visible_ui"
    },
    "questions": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "section": {
            "type": "string",
            "maxLength": 20000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "paragraph",
              "number",
              "single_choice",
              "multiple_choice",
              "dropdown",
              "unsupported"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "options": {
            "default": [],
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "matrix": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "row": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "required": [
              "id",
              "title",
              "row"
            ],
            "additionalProperties": false
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "section",
          "text",
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "url",
    "title",
    "scope",
    "observedAt",
    "method",
    "questions"
  ],
  "additionalProperties": false
}
